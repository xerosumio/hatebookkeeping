# ─────────────────────────────────────────────────────────────────────────────
# HateBookkeeping configuration
#
# Copy to .env and fill in. Every value here is validated at boot by
# packages/server/src/config/env.ts — the process refuses to start on a bad
# config rather than failing later against real money.
#
# See docs/SETUP.md for how to obtain each of these.
# ─────────────────────────────────────────────────────────────────────────────

NODE_ENV=development
PORT=3000

# Public origin of the API/MCP server. Must be the exact scheme + host + port
# that clients reach. Authentik redirect URIs are built from this.
PUBLIC_URL=http://localhost:3000

# Origin the web app is served from. Required in production: the GitHub Pages
# origin if the SPA is hosted separately, or the same value as PUBLIC_URL if
# this process serves the web app. CORS and the post-login redirect use it.
WEB_ORIGIN=http://localhost:5173

# ── MongoDB ──────────────────────────────────────────────────────────────────
MONGODB_URI=mongodb://localhost:27017/hatebookkeeping

# Uploaded receipts, chops, signatures. Coolify should mount a volume here.
UPLOAD_DIR=./uploads

# ── Authentik / OIDC ─────────────────────────────────────────────────────────
# Issuer is the application slug's OIDC base, e.g.
#   https://authentik.example.com/application/o/hatebookkeeping/
# Redirect URI to register in Authentik: <PUBLIC_URL>/api/auth/callback
OIDC_ISSUER=https://authentik.example.com/application/o/hatebookkeeping/
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_SCOPES=openid profile email
OIDC_ADMIN_GROUP=hbk-admins

# Signs web session tokens (hbk_web_…). Generate with: openssl rand -base64 48
SESSION_SECRET=

# ── Email (optional) ─────────────────────────────────────────────────────────
EMAIL_API_URL=
EMAIL_API_KEY=

# ── Airwallex (optional — live bank balances) ────────────────────────────────
AIRWALLEX_AX_CLIENT_ID=
AIRWALLEX_AX_API_KEY=
AIRWALLEX_AX_ACCOUNT_ID=
AIRWALLEX_NT_CLIENT_ID=
AIRWALLEX_NT_API_KEY=
AIRWALLEX_NT_ACCOUNT_ID=
