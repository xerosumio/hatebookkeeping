# HateBookkeeping API configuration.
#
# Copy to .env and fill in. The API checks every value when it starts
# (packages/server/src/platform/config.ts) and refuses to start if one is
# wrong. docs/SETUP.md explains where each value comes from.
#
# To try the app without any of this, run `npm run dev:local`.

NODE_ENV=development
PORT=3000

# The address people's browsers use to reach the API: scheme, host and port,
# no trailing slash. The Authentik redirect address is built from it.
PUBLIC_URL=https://books-api.example.com

# The address the web app is served from. Required in production. The API
# accepts browser requests only from here and sends people back here after
# sign-in. For local development this is the Vite dev server's address.
WEB_ORIGIN=https://books.example.com

# MongoDB. The database name is the last part of the address. Use a NEW name
# for the rebuilt app (for example hatebookkeeping_v2) so the old data is
# left untouched.
MONGODB_URI=mongodb://localhost:27017/hatebookkeeping_v2

# Authentik (OIDC). Register this redirect address in Authentik:
#   <PUBLIC_URL>/api/auth/callback
OIDC_ISSUER=https://authentik.example.com/application/o/hatebookkeeping/
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_SCOPES=openid profile email

# Members of this Authentik group become admins when they sign in. This is how
# the first admin gets in on an empty database. Leaving the group later does
# not remove the admin role; another admin does that on the Users page.
OIDC_ADMIN_GROUP=hbk-admins

# Signs sign-in sessions. At least 32 characters: openssl rand -base64 48
SESSION_SECRET=

# Email for approval requests and recurring reminders (optional). Without it
# the app still works, and each item's history says the email was not sent.
EMAIL_API_URL=
EMAIL_API_KEY=
