{
  "name": "@hbk/server",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json && cp -r src/integrations/pdf/fonts dist/integrations/pdf/fonts",
    "typecheck": "tsc --noEmit",
    "dev": "tsx watch src/index.ts",
    "dev:local": "tsx watch test/dev-server.ts",
    "start": "node dist/index.js",
    "test": "tsx --test --test-concurrency=1 test/*.test.ts",
    "clean": "rm -rf dist tsconfig.tsbuildinfo"
  },
  "dependencies": {
    "@hbk/shared": "*",
    "@react-pdf/renderer": "^4.5.1",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "jose": "^6.2.0",
    "mongoose": "^8.9.5",
    "multer": "^2.0.2",
    "node-cron": "^4.2.1",
    "openid-client": "^6.8.5",
    "react": "^19.2.5",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/multer": "^2.0.0",
    "@types/node": "^22.10.7",
    "@types/react": "^19.2.14",
    "@types/supertest": "^6.0.2",
    "mongodb-memory-server": "^10.1.4",
    "supertest": "^7.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
