{
  "name": "@hbk/server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "build": "tsc --noCheck && cp -r src/utils/pdf/fonts dist/utils/pdf/fonts",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "test": "tsx --test src/utils/hkDate.test.ts src/services/periodFigures.test.ts src/services/monthPlan.test.ts src/services/takeOut.test.ts",
    "seed": "tsx src/seed.ts",
    "seed:demo": "tsx src/seed-demo.ts",
    "audit:data": "tsx scripts/data-audit.ts",
    "clean": "rm -rf dist tsconfig.tsbuildinfo"
  },
  "dependencies": {
    "@hbk/shared": "*",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@react-pdf/renderer": "^4.5.1",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "jose": "^6.2.0",
    "mongoose": "^8.9.5",
    "multer": "^1.4.5-lts.1",
    "node-cron": "^4.2.1",
    "openid-client": "^6.8.5",
    "react": "^19.2.5",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.10.7",
    "@types/node-cron": "^3.0.11",
    "@types/react": "^19.2.14",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
