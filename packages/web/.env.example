# Backend API URL (set at build time; empty = same origin via the Vite proxy)
# VITE_API_URL=https://api.example.com

# Workspace suite links (shown in the app switcher). Leave blank to hide that app.
# VITE_SUITE_NDOC_URL=https://doc.example.com
# VITE_SUITE_NDRIVE_URL=https://drive.example.com
# VITE_SUITE_KANBAN_URL=https://kanban.example.com
# VITE_SUITE_ORBIT_URL=https://orbit.example.com
# VITE_SUITE_HBK_URL=https://hbk.example.com
# VITE_SUITE_LOOM_URL=https://loom.example.com
# VITE_SUITE_MEMORY_URL=https://memory.example.com
# VITE_SUITE_NOPS_URL=https://nops.example.com
# VITE_SUITE_FASTMAIL_URL=https://app.fastmail.com
